{
  "name": "emalahleni-beneficiary-assurance",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "npm --prefix scanner install --ignore-scripts --no-audit --no-fund",
    "dev": "wrangler dev --port 8787",
    "dev:web": "next dev web --port 3000",
    "build": "next build web && wrangler deploy --dry-run --containers-rollout=none --outdir dist/worker",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --import tsx tests/run.ts",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "latest",
    "@neondatabase/serverless": "latest",
    "@react-pdf/renderer": "4.9.0",
    "exifr": "7.1.3",
    "jose": "^6.0.0",
    "next": "^16.0.0",
    "pdf-lib": "1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
