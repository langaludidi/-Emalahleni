{
  "name": "emalahleni-api-staging",
  "account_id": "f887a522ca852a80491c2485853d4363",
  "main": "src/entrypoint.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "routes": [{ "pattern": "app.vectrasa.co.za", "custom_domain": true }],
  "preview_urls": false,
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } },
  "assets": { "directory": "./web/out", "binding": "ASSETS", "run_worker_first": ["/api/*", "/healthz", "/storage-healthz", "/storage-probe"] },
  "r2_buckets": [{ "binding": "EVIDENCE_BUCKET", "bucket_name": "emalahleni-evidence-staging" }],
  "durable_objects": { "bindings": [{ "name": "SCANNER_CONTAINER", "class_name": "DocumentScanner" }] },
  "exports": { "DocumentScanner": { "type": "durable-object", "storage": "sqlite", "container": "emalahleni-scanner-staging-documentscanner" } },
  "containers": [{ "name": "emalahleni-scanner-staging-documentscanner", "class_name": "DocumentScanner", "image": "./scanner/Dockerfile", "image_build_context": "./scanner", "max_instances": 1, "instance_type": "standard-1", "observability": { "enabled": true } }],
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "2026101601", "simple": { "limit": 120, "period": 60 } },
    { "name": "WRITE_RATE_LIMITER", "namespace_id": "2026101602", "simple": { "limit": 30, "period": 60 } },
    { "name": "DOCUMENT_RATE_LIMITER", "namespace_id": "2026101603", "simple": { "limit": 12, "period": 60 } }
  ],
  "vars": {
    "ENABLE_API_RATE_LIMITS": "true",
    "ENABLE_CASE_API": "true",
    "ENABLE_DOCUMENT_UPLOADS": "true",
    "ENABLE_ID_READING": "true",
    "NEON_AUTH_BASE_URL": "https://ep-cold-scene-zaa3qek2.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth",
    "NEON_AUTH_JWKS_URL": "https://ep-cold-scene-zaa3qek2.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
  }
}

