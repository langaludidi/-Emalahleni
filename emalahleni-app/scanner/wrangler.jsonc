{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"emalahleni-scanner-staging",
  "account_id":"f887a522ca852a80491c2485853d4363",
  "main":"container-worker.ts",
  "compatibility_date":"2026-10-15",
  "workers_dev":false,
  "preview_urls":false,
  "containers":[{"class_name":"DocumentScanner","image":"./Dockerfile","max_instances":1,"instance_type":"standard-1"}],
  "durable_objects":{"bindings":[{"name":"SCANNER_CONTAINER","class_name":"DocumentScanner"}]},
  "exports":{"DocumentScanner":{"type":"durable-object","storage":"sqlite"}}
}
