{
  "name": "emalahleni-private-scanner",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && wrangler deploy --dry-run --outdir /tmp/emalahleni-scanner-worker --containers-rollout=none",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
